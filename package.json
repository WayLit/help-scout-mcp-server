{
  "name": "helpscout-mcp-worker",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "description": "Remote MCP server for Help Scout, deployed as a Cloudflare Worker with per-user OAuth",
  "homepage": "https://github.com/WayLit/help-scout-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/WayLit/help-scout-mcp-server/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Drew Burchfield",
    "url": "https://github.com/drewburchfield"
  },
  "contributors": [
    {
      "name": "Satya Mishra",
      "url": "https://github.com/WayLit"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayLit/help-scout-mcp-server.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "security": "semgrep --config .semgrep.yml .",
    "security:ci": "semgrep ci"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agents": "^0.30.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "openredaction": "^1.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
