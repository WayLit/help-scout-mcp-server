// Copy this file to `wrangler.custom.jsonc` (gitignored), fill in your hostname
// and KV IDs, then deploy with:
//   wrangler deploy --config wrangler.custom.jsonc
//
// `--config` replaces (does not merge with) the default `wrangler.jsonc`, so
// this file must be a complete worker config. Keep it in sync if you upgrade
// the base config in `wrangler.jsonc`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpscout-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  // No `id` set: Wrangler's automatic resource provisioning creates/links
  // the namespace on first deploy and reuses it on every deploy after.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "HelpScoutMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HelpScoutMCP"] }],
  "observability": { "enabled": true },
  "dev": { "port": 8788 },
  // Polyfill node:module so packages that call createRequire(import.meta.url)
  // as a CJS shim (e.g. openredaction) don't blow up at Workers validation
  // time. The shim is never actually invoked at runtime.
  "alias": {
    "node:module": "./src/polyfills/node-module.ts"
  },
  // The hostname's zone must be a Cloudflare-managed zone on this account
  // before deploy. `custom_domain: true` provisions DNS automatically.
  "routes": [
    { "pattern": "helpscout-mcp.example.com", "custom_domain": true }
  ],
  "vars": {
    "OAUTH_ALLOWED_REDIRECT_HOSTS": "claude.ai"
  }
}
