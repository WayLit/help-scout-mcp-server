{
  "name": "helpscout-mcp-worker",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "Remote MCP server for Help Scout, deployed as a Cloudflare Worker with per-user OAuth",
  "homepage": "https://github.com/WayLit/help-scout-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/WayLit/help-scout-mcp-server/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Drew Burchfield",
    "url": "https://github.com/drewburchfield"
  },
  "contributors": [
    {
      "name": "Satya Mishra",
      "url": "https://github.com/WayLit"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayLit/help-scout-mcp-server.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "security": "semgrep --config .semgrep.yml .",
    "security:ci": "semgrep ci"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.20.1",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "openredaction": "^1.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
